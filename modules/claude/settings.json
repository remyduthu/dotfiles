{
  "cleanupPeriodDays": 180,
  "permissions": {
    "allow": [
      "Bash(* --help)",
      "Bash(* --version)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(gh api */comments *)",
      "Bash(gh issue view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr view *)",
      "Bash(gh repo view *)",
      "Bash(gh run view *)",
      "Bash(git add *)",
      "Bash(git checkout *)",
      "Bash(git commit *)",
      "Bash(git fetch *)",
      "Bash(git rebase *)",
      "Bash(git show *)",
      "Bash(git switch *)",
      "Bash(grep *)",
      "Bash(mergify *)",
      "Bash(npm *)",
      "Bash(uv *)",
      "Edit",
      "Read",
      "WebFetch"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "i=$(cat); d=$(echo \"$i\" | jq -r '.cwd' | sed \"s|^$HOME|~|\"); t=$(echo \"$i\" | jq -r '.context_window.total_input_tokens // empty'); s=$(echo \"$i\" | jq -r '.context_window.context_window_size // empty'); cs=\"\"; [ -n \"$t\" ] && [ -n \"$s\" ] && u=$(awk -v t=\"$t\" -v s=\"$s\" 'BEGIN{p=(s>0)?t/s*100:0; printf \"%.1fk (%.1f%%)\", t/1000, p}') && cs=$(printf ' · \\033[33m%s\\033[0m' \"$u\"); r=$(echo \"$i\" | jq -r '.rate_limits.five_hour.used_percentage // empty'); w=$(echo \"$i\" | jq -r '.rate_limits.seven_day.used_percentage // empty'); rl=\"\"; [ -n \"$r\" ] && rl=$(printf '%.0f%%/5h' \"$r\"); [ -n \"$w\" ] && rl=\"${rl:+$rl }$(printf '(%.0f%%/7d)' \"$w\")\"; [ -n \"$rl\" ] && rl=$(printf ' · \\033[35m%s\\033[0m' \"$rl\"); printf '\\033[36m%s\\033[0m%s%s\\n' \"$d\" \"$cs\" \"$rl\""
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "mergify-internal@mergify-internal": true,
    "mattpocock-skills@mattpocock": true,
    "datadog@claude-plugins-official": true,
    "frontend-design@claude-code-plugins": true
  },
  "extraKnownMarketplaces": {
    "mergify-internal": {
      "source": {
        "source": "directory",
        "path": "/Users/remyduthu/dev/mergify/skills"
      }
    },
    "mattpocock": {
      "source": {
        "source": "github",
        "repo": "mattpocock/skills"
      }
    },
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code"
      }
    }
  },
  "effortLevel": "high",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "tap"
  },
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "preferredNotifChannel": "notifications_disabled",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true
}